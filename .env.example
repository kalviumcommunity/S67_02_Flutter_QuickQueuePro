# .env.example – Copy this file to .env and fill in your real values.
# .env is gitignored and must NEVER be committed to version control.
# Obtain values from: Firebase Console → Project Settings → Your apps.

# ── Shared Firebase project values ──────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ── Android ──────────────────────────────────────────────────
FIREBASE_ANDROID_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_ANDROID_APP_ID=1:000000000000:android:xxxxxxxxxxxxxxxxxxxx

# ── iOS ──────────────────────────────────────────────────────
FIREBASE_IOS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxxxxxxxxxx
FIREBASE_IOS_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
FIREBASE_IOS_BUNDLE_ID=com.yourcompany.quickQueuePro

# ── Web ──────────────────────────────────────────────────────
FIREBASE_WEB_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_WEB_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX

# ── macOS ────────────────────────────────────────────────────
FIREBASE_MACOS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_MACOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxxxxxxxxxx
FIREBASE_MACOS_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
FIREBASE_MACOS_BUNDLE_ID=com.yourcompany.quickQueuePro

# ── Windows ──────────────────────────────────────────────────
FIREBASE_WINDOWS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_WINDOWS_APP_ID=1:000000000000:windows:xxxxxxxxxxxxxxxxxxxx
